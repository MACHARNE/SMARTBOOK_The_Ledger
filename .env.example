# Public Supabase values used by the same-origin /api/config response.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secret. Never use this in frontend code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional direct PostgreSQL connection for local tools; the Supabase CLI does not need this.
POSTGRES_URL=postgresql://postgres:replace-me@db.your-project.supabase.co:5432/postgres?sslmode=require

# Supabase CLI personal access token. Keep only in local ignored .env; never add to Vercel.
SUPABASE_ACCESS_TOKEN=your-supabase-cli-access-token

# Must be allowed in Supabase Auth URL Configuration. Also allow the production
# app's /signup (company invite), /admin/login, /super-admin/login, and /login URLs.
AUTH_EMAIL_REDIRECT_URL=http://localhost:3000

# Staging-only test guard; set to the separate staging project reference locally.
SMARTBOOK_STAGING_PROJECT_REF=your-staging-project-ref

# One-time initial admin provisioning. Set only for a controlled server deployment
# when bootstrapping an empty platform; remove all three immediately afterward.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_TEMP_PASSWORD=replace-with-a-random-temporary-password
INITIAL_ADMIN_PROVISION_SECRET=replace-with-a-long-random-one-time-secret
