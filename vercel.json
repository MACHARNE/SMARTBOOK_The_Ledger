{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?route=$1" },
    { "source": "/", "destination": "/fb091d/index.html" },
    { "source": "/signup", "destination": "/fb091d/index.html" },
    { "source": "/login", "destination": "/fb091d/index.html" },
    { "source": "/admin/login", "destination": "/fb091d/index.html" },
    { "source": "/super-admin/login", "destination": "/fb091d/index.html" }
  ]
}
